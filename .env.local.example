# URL publique de l'app — sert à construire les URLs de callback PayTech
# (ipn_url/success_url/cancel_url) pour le paiement d'abonnement école -> iziecole.
# À changer pour le domaine réel en prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayTech — paiement de l'abonnement iziecole par l'école (pas les frais de
# scolarité, voir docs/decisions.md)
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=prod
